#include <stdio.h>

int main() {
    int n;
    printf("Enter the size of the matrix (odd number): ");
    scanf("%d", &n);

    if (n % 2 == 0) {
        printf("Please enter an odd number.\n");
        return 1;
    }

    int matrix[n][n];

    printf("Enter the elements of the %dx%d matrix:\n", n, n);
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &matrix[i][j]);

    int sum = 0;

    // Top row
    for (int j = 0; j < n; j++)
        sum += matrix[0][j];

    // Bottom row
    for (int j = 0; j < n; j++)
        sum += matrix[n-1][j];

    // Left column (excluding corners)
    for (int i = 1; i < n-1; i++)
        sum += matrix[i][0];

    // Right column (excluding corners)
    for (int i = 1; i < n-1; i++)
        sum += matrix[i][n-1];

    printf("Sum of border elements: %d\n", sum);
    return 0;
}
