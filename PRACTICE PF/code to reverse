#include <stdio.h>
int main() {
    int i ,j, temp ;
    int arr[10]={5,3,9,10,7,6,8,4,2,1};
    for (i=0; i<10; i++){
        for(j=0; j<10; j++){
        if(arr[j]>arr[j+1]){
           temp=arr[j+1];
           arr[j+1]=arr[j];
           arr[j]=temp;
           }
        }
    }
    for(i=0; i<10; i++){
        printf("\n%d\n",arr[i]);
    }
    return 0;
}
