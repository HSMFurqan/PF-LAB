#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char name[50];
    int roll;
    int numSubjects;
    int *credits;
    float *grades;
    float sgpa;
} Student;

// Function to calculate SGPA
float calculateSGPA(int *credits, float *grades, int n) {
    float totalPoints = 0;
    int totalCredits = 0;

    for (int i = 0; i < n; i++) {
        totalPoints += (*(grades + i)) * (*(credits + i));
        totalCredits += *(credits + i);
    }

    return totalPoints / totalCredits;
}

int main() {
    int numStudents;
    printf("Enter number of students: ");
    scanf("%d", &numStudents);

    // Allocate memory for student records
    Student *students = (Student *)malloc(numStudents * sizeof(Student));

    for (int i = 0; i < numStudents; i++) {
        printf("\n--- Enter details for Student %d ---\n", i + 1);

        printf("Name: ");
        scanf(" %[^\n]", (students + i)->name);

        printf("Roll Number: ");
        scanf("%d", &(students + i)->roll);

        printf("Enter number of subjects: ");
        scanf("%d", &(students + i)->numSubjects);

        int n = (students + i)->numSubjects;

        // Allocate memory for credits and grades
        (students + i)->credits = (int *)malloc(n * sizeof(int));
        (students + i)->grades = (float *)malloc(n * sizeof(float));

        printf("Enter credits for each subject:\n");
        for (int j = 0; j < n; j++) {
            scanf("%d", &((students + i)->credits[j]));
        }

        printf("Enter grade points for each subject:\n");
        for (int j = 0; j < n; j++) {
            scanf("%f", &((students + i)->grades[j]));
        }

        // Calculate SGPA
        (students + i)->sgpa = calculateSGPA((students + i)->credits, (students + i)->grades, n);
    }

    printf("\n========= Student SGPA Records =========\n");
    float totalSGPA = 0;
    for (int i = 0; i < numStudents; i++) {
        printf("Name: %s\n", (students + i)->name);
        printf("Roll: %d\n", (students + i)->roll);
        printf("SGPA: %.2f\n\n", (students + i)->sgpa);
        totalSGPA += (students + i)->sgpa;

        // Free individual subject memory
        free((students + i)->credits);
        free((students + i)->grades);
    }

    float cgpa = totalSGPA / numStudents;
    printf("Overall CGPA of all students: %.2f\n", cgpa);

    // Free overall student memory
    free(students);

    return 0;
}
