#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Employee {
    char name[50];
    int id;
    float salary;
};

struct Company {
    char name[50];
    struct Employee *employees;
    int empCount;
};

void sortEmployees(struct Employee *e, int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (e[i].salary < e[j].salary) {
                struct Employee temp = e[i];
                e[i] = e[j];
                e[j] = temp;
            }
}

int main() {
    struct Company c;
    printf("Enter company name: ");
    scanf(" %[^\n]", c.name);

    printf("Enter number of employees: ");
    scanf("%d", &c.empCount);

    c.employees = (struct Employee *)malloc(c.empCount * sizeof(struct Employee));

    for (int i = 0; i < c.empCount; i++) {
        printf("Enter ID, Name, Salary for employee %d: ", i + 1);
        scanf("%d %s %f", &c.employees[i].id, c.employees[i].name, &c.employees[i].salary);
    }

    sortEmployees(c.employees, c.empCount);

    printf("\n--- Sorted Employees by Salary ---\n");
    printf("ID\tName\tSalary\n");
    for (int i = 0; i < c.empCount; i++) {
        printf("%d\t%s\t%.2f\n", c.employees[i].id, c.employees[i].name, c.employees[i].salary);
    }

    free(c.employees);
    return 0;
}
